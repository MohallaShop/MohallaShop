# ─────────────────────────────────────────────────────────────
# MohallaShop — environment variables (PLACEHOLDERS ONLY)
# Copy to `.env` and fill with real values. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Environment ───────────────────────────────────────────────
# development | staging | production
APP_ENV=development
LOG_LEVEL=DEBUG

# ── Backend (FastAPI) ─────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed origins for CORS
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Database (PostgreSQL) ─────────────────────────────────────
# Used by docker-compose and the backend. Format:
# postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
# (plain postgresql:// URLs are auto-upgraded to the asyncpg scheme)
POSTGRES_USER=mohalla
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mohallashop
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://mohalla:changeme@localhost:5432/mohallashop
# Supabase: keep BOTH connection variants below; DATABASE_URL above is the
# ACTIVE one. If a password contains special chars (e.g. @), percent-encode
# them (%40). Placeholders only — never commit real connection strings.
# Direct connection (port 5432; on newer projects IPv6-only unless the
# IPv4 add-on is enabled):
DATABASE_URL_DIRECT=postgresql://postgres.YOUR-PROJECT-ref:YOUR-PASSWORD@db.YOUR-PROJECT-ref.supabase.co:5432/postgres
# Transaction pooler (port 6543; IPv4, recommended for development):
DATABASE_URL_POOLER=postgresql://postgres.YOUR-PROJECT-ref:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres
# Number of connections in the pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Supabase (Auth) ───────────────────────────────────────────
# Project URL + publishable/anon key are safe for the browser; the
# secret/service-role key is server-only.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SECRET_KEY=replace-with-secret-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Legacy HS256 projects verify access tokens with the shared JWT secret:
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret
SUPABASE_JWT_ALGORITHM=HS256
# Production requires explicit issuer + audience validation (the backend rejects
# startup in production without them). Development tolerates their absence.
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=
# New projects (publishable/secret keys) sign access tokens with an asymmetric
# key published at the JWKS URL — set this (and SUPABASE_JWT_ALGORITHM=ES256 or
# =RS256) and the backend verifies via JWKS instead of the shared secret:
SUPABASE_JWKS_URL=https://YOUR-PROJECT-ref.supabase.co/auth/v1/.well-known/jwks.json
# ── Authentication methods ────────────────────────────────────
# Email OTP is ACTIVE. Required: the Supabase "Email OTP" template
# (Authentication → Emails → Templates) must include {{ .Token }} so the email
# contains the numeric verification code, e.g. "Your MohallaShop verification
# code is: {{ .Token }}". A template with only {{ .ConfirmationURL }} sends a
# magic link, which the customer OTP flow does not use.
# Phone OTP is DEFERRED: the SMS provider is not configured, so the login UI
# keeps Phone disabled ("Coming soon"). Configure Authentication → Phone →
# Twilio/other, live-test SMS delivery, then flip `phone.enabled` in
# apps/web/lib/config/auth.ts.
# Google OAuth is DEFERRED: configure the provider + redirect URL in the
# Supabase dashboard, then flip `google.enabled` in apps/web/lib/config/auth.ts.
# No new env vars are required for either deferred method (the publishable key
# above is sufficient).

# ── Frontend (Next.js) ────────────────────────────────────────
# Base URL of the FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Use the key format your project issues (publishable OR legacy anon):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Payments (Razorpay) — Phase 1b, placeholders for now ──────
RAZORPAY_KEY_ID=replace-with-key-id
RAZORPAY_KEY_SECRET=replace-with-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

# ── Security ──────────────────────────────────────────────────
# Any request-sending origin must be listed in BACKEND_CORS_ORIGINS
RATE_LIMIT_ENABLED=true
