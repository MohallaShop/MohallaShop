# Backend-local env. Most variables live in the repo-root .env.
# Copy this file to `backend/.env` if you prefer backend-local config.
# In normal development the root `.env` is sufficient because pydantic-settings
# reads from the process environment.

APP_ENV=development
LOG_LEVEL=DEBUG
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://mohalla:changeme@localhost:5432/mohallashop
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SECRET_KEY=replace-with-secret-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Legacy HS256 projects: SUPABASE_JWT_SECRET + SUPABASE_JWT_ALGORITHM=HS256.
# New projects: SUPABASE_JWKS_URL + SUPABASE_JWT_ALGORITHM=ES256|RS256
# (JWKS takes precedence when set).
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=
SUPABASE_JWKS_URL=https://YOUR-PROJECT-ref.supabase.co/auth/v1/.well-known/jwks.json

RATE_LIMIT_ENABLED=true
