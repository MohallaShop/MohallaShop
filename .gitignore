# ─────────────────────────────────────────────────────────────
# MohallaShop — root .gitignore
# ─────────────────────────────────────────────────────────────

# ── Secrets / environment (never commit) ──────────────────────
.env
.env.*
!.env.example
!.env.*.example
*.env
.env.local
.env.development
.env.production
.env.staging
supabase/.env
backend/.env
apps/web/.env.local

# ── Node / pnpm ───────────────────────────────────────────────
node_modules/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
**/.pnpm-store/

# ── Next.js ───────────────────────────────────────────────────
.next/
out/
build/
dist/
.next/cache/
.vercel
next-env.d.ts
*.tsbuildinfo

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.tox/
.nox/
pip-wheel-metadata/
share/python-wheels/

# ── uv ────────────────────────────────────────────────────────
# uv.lock IS committed (reproducible installs).

# ── Alembic ───────────────────────────────────────────────────
# migrations are tracked; only ignore local DB file artifacts

# ── Testing / E2E ─────────────────────────────────────────────
test-results/
playwright-report/
playwright/.cache/
*.lcov

# ── Throwaway local debug scripts (backend root) ─────────────
# One-off DB/debug scripts; the real suite lives in backend/tests/.
# NEVER commit these — some contain hardcoded dev session tokens.
/backend/test_*.py

# ── Build / bundle artifacts ──────────────────────────────────
*.log
logs/
*.pid
*.seed
*.pid.lock

# ── Docker ────────────────────────────────────────────────────
# docker-compose override files for local-only config
docker-compose.override.yml

# ── PostgreSQL / DB volumes (local dev) ───────────────────────
pgdata/
*.sqlite
*.sqlite3
*.db

# ── IDE / editors ─────────────────────────────────────────────
.idea/
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── OS ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── Misc ──────────────────────────────────────────────────────
.cache/
.temp/
tmp/
*.local
.directory
