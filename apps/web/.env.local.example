# Frontend (Next.js) public environment.
# Copy to `.env.local` and fill values. Variables MUST be prefixed with
# NEXT_PUBLIC_ to be exposed to the browser.

# Base URL of the FastAPI backend (versioned API root).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Supabase project.
# Use the CURRENT key format your project issues:
#   - Newer projects: publishable key (sb_publishable_...) in
#     NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   - Legacy projects: anon key (eyJ...) in NEXT_PUBLIC_SUPABASE_ANON_KEY
# The publishable/anon key is safe for the browser; the service-role key is NOT.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Authentication methods (see apps/web/lib/config/auth.ts):
# - Email OTP: ACTIVE. Requires the Supabase "Email OTP" template to include
#   {{ .Token }} (numeric code) — Authentication → Emails → Templates.
# - Phone OTP: disabled ("Coming soon") until an SMS provider is configured and
#   live-tested in Supabase. Implementation stays intact; flip `phone.enabled`
#   to re-enable.
# - Google OAuth: disabled until the provider is configured in the dashboard.

# Canonical site URL (used for SEO metadata + sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
